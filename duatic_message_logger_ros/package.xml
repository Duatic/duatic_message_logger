<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_message_logger_ros</name>
  <version>1.0.0</version>
  <description>Routes duatic_message_logger output to the ROS 2 logging system</description>
  <maintainer email="lnachtigall@duatic.com">Lennart Nachtigall</maintainer>
  <license>BSD3-Clause</license>

  <buildtool_depend>ament_cmake_ros</buildtool_depend>

  <depend>duatic_message_logger</depend>
  <depend>rclcpp</depend>
  <depend>rcutils</depend>
  <depend>spdlog</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
